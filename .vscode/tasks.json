{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "Watch",
			"type": "process",
			"command": "npm",
			"windows": {
				"command": "npm.cmd"
			},
			"args": [
				"run-script",
				"start"
			],
			"isBackground": true,
			"problemMatcher": {
				"pattern": {
					"regexp": "^(.+):(.+): (error|warning): (TS\\d+) (.+)$",
					"file": 1,
					"location": 2,
					"severity": 3,
					"code": 4,
					"message": 5
				},
				"background": {
					"activeOnStart": true,
					"beginsPattern": "dt-app dev --no-open",
					"endsPattern": "Development server started successfully."
				}
			}
		},
		{
			"label": "Git commit infra redesign",
			"type": "shell",
			"command": "git add -A && git commit -m \"refactor: Infrastructure page - remove duplicates (providers/workloads/problems moved to other pages), add unique service config snapshot + model version history\" && git push origin master",
			"isBackground": false
		}
	]
}